# mock 无需模型或搜索凭证；真实模式改为 real
CDR_MODE=mock
CDR_OPENAI_API_KEY=
CDR_ANTHROPIC_API_KEY=
# DeepSeek 配置可将密钥放在一个不纳入版本控制的纯文本文件中，例如：
# CDR_DEEPSEEK_API_KEY_FILE=keys.txt
# JSON POST 搜索协议详见 docs/LLM_CONFIGURATION.md
CDR_SEARCH_URL=
CDR_SEARCH_KEY=
CDR_SEARCH_KEY_FILE=
CDR_SEARCH_AUTH_HEADER=Authorization
CDR_SEARCH_PROVIDER=generic
CDR_CONCURRENCY=3
CDR_MAX_ACTIVE_RUNS=2
CDR_MAX_RESEARCH_ROUNDS=3
# 业务行业资料：每槽最多 1 次宽搜索 + 2 次按缺口分组补查；模型最多补充 3 个中性大方向
CDR_MATERIAL_SEARCH_BUDGET=3
CDR_MATERIAL_DOCUMENT_BUDGET=8
CDR_MATERIAL_EXTRA_DIRECTION_LIMIT=3
CDR_MATERIAL_POLICY_YEARS=3
CDR_MAX_REPLANS=2
CDR_MAX_REVISIONS=2
CDR_ALLOW_LIMITED=true
CDR_MOCK_DELAY=0.15
CDR_EXTRACTION_INPUT_TOKENS=16000
# token 估算系数（换模型后按日志中的 "token estimate low" 警告调整）
CDR_TOKENS_PER_CJK=1.0
CDR_CHARS_PER_TOKEN=3
# 可重试错误的退避：基准秒数与上限秒数
CDR_RETRY_BASE_SECONDS=1
CDR_RETRY_MAX_SECONDS=30
# 分析/写作/审核附加 skills/ 中的方法步骤；false 关闭
CDR_METHOD_GUIDANCE=true
# CDR_SKILLS_DIR=C:/research/skills
CDR_MAX_BATCH_SPLITS=2
CDR_PLAN_REPAIRS=2
CDR_CACHE_TTL_HOURS=6
# 默认只统计调用次数；设为 true 才启用以下总调用/每块调用硬上限
CDR_ENFORCE_CALL_BUDGETS=false
CDR_BLOCK_CALL_BUDGET=40
CDR_GLOBAL_CALL_BUDGET=240
CDR_GLOBAL_TOKEN_BUDGET=50000000
# 阶段成果单包上限（字节）；超限明确报错，不省略内容
CDR_WORK_PRODUCT_MAX_BYTES=50000000
CDR_REFERENCE_MAX_FILES=50
# 以上为预算上限示例。真实研究须确认可接受的上限，预算使用保守输入估算和输出预留。
# 路径默认相对于仓库位置自动确定，可填写绝对路径
# CDR_LOCAL_SOURCES=C:/research/materials
# CDR_MODELS_CONFIG=C:/research/configs/models.yaml
